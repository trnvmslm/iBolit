# Copy to .env. All data in this project is fake test data.
ENV=dev
DEBUG=true
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0
CORS_ALLOWED_ORIGINS=
# Host runs (tests, manage.py) use localhost; docker compose overrides this for the web container.
DATABASE_URL=postgres://ibolit:ibolit@localhost:5433/ibolit
MEDIA_ROOT=./media
# Video: VIDEO_PROVIDER=zego with real ZEGOCLOUD keys, or mock (also used when keys are empty).
VIDEO_PROVIDER=zego
ZEGO_APP_ID=0
ZEGO_SERVER_SECRET=
